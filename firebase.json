{
  "functions": {
    "source": "backend"
  },
  "hosting": {
    "public": "frontend",
    "cleanURLs": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": "flask_app"
      }
    ]
  }
}
